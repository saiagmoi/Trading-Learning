# yahoo = datos reales de Yahoo Finance (retrasados ~15 min, sin API key)
# demo  = serie sintética claramente etiquetada "DATOS DE DEMOSTRACIÓN"
MARKET_DATA_PROVIDER=yahoo

# Reservado para un proveedor futuro (Alpha Vantage, Twelve Data, etc.)
# Nunca expongas esta clave en el frontend.
# ALPHA_VANTAGE_API_KEY=
# TWELVE_DATA_API_KEY=

# LIVE TRADING permanece deshabilitado en esta versión educativa.
LIVE_TRADING_ENABLED=false
