# yahoo = datos reales de Yahoo Finance (retrasados ~15 min, sin API key)
# demo  = serie sintética claramente etiquetada "DATOS DE DEMOSTRACIÓN"
MARKET_DATA_PROVIDER=yahoo

# Reservado para un proveedor futuro (Alpha Vantage, Twelve Data, etc.)
# Nunca expongas esta clave en el frontend.
# ALPHA_VANTAGE_API_KEY=
# TWELVE_DATA_API_KEY=

# LIVE TRADING permanece deshabilitado en esta versión educativa.
LIVE_TRADING_ENABLED=false

# Competencia: clave privada de API y modelo compatible con Responses + Structured Outputs.
# Ambos son necesarios para habilitar el inicio. No uses NEXT_PUBLIC_ para estos valores.
OPENAI_API_KEY=
OPENAI_MODEL=

# Opcional: token privado para ejecutar competition:worker sin navegador.
COMPETITION_ACCESS_TOKEN=
# URL local si la app usa otro puerto.
COMPETITION_URL=http://localhost:3000
# Opcional: directorio persistente para los registros (por defecto .data).
# COMPETITION_DATA_DIR=
